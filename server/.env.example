NODE_ENV=production
PORT=5000

# MongoDB connection string (MongoDB Atlas cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-domain>/skillbridge?retryWrites=true&w=majority

# JWT secret — change to a cryptographically strong random string
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Client URL (for CORS and WebSocket handshakes)
CLIENT_URL=https://skillbridge-ethiopia.vercel.app

# Optional: Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
